{
  "expo": {
    "name": "GG",
    "slug": "gg",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abhiram35.gg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111A22",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abhiram35.gg"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "GG needs access to your photos so you can set a profile picture."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#D63A2F"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "scheme": "gg",
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
